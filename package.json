{
  "name": "petalo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SAP Fiori (Horizon) look and interaction for React, distributed as a shadcn registry.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/snest007/petalo.git"
  },
  "homepage": "https://snest007.github.io/petalo/",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "illustrations": "node scripts/generate-illustrations.mjs",
    "generate": "pnpm tokens && pnpm icons && pnpm illustrations && pnpm css",
    "dev": "pnpm css && vite",
    "build": "pnpm css && vite build",
    "build:pages": "REGISTRY_URL=https://snest007.github.io/petalo/r BASE_PATH=/petalo/ pnpm registry:build && BASE_PATH=/petalo/ pnpm build && pnpm storybook:build && node -e \"require('node:fs').cpSync('storybook-static', 'dist/storybook', { recursive: true }); require('node:fs').writeFileSync('dist/.nojekyll', '')\"",
    "preview": "vite preview --port 4173 --strictPort",
    "sapui5:serve": "cd sapui5 && ui5 serve --port ${SAPUI5_PORT:-4174}",
    "registry:build": "pnpm css && node scripts/build-registry-json.mjs --require-usage && shadcn build registry.json --output public/r && pnpm skill:build",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "check": "pnpm generate && pnpm typecheck && pnpm registry:build && pnpm skill:eval && pnpm build && pnpm test && pnpm storybook:build && pnpm test:storybook",
    "css": "node scripts/build-components-css.mjs",
    "skill:build": "node scripts/build-skill.mjs",
    "skill:eval": "node scripts/eval-skill.mjs",
    "skill:eval-build": "node scripts/eval-skill-build.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "pnpm css && storybook build -o storybook-static --quiet",
    "test:storybook": "playwright test -c playwright.storybook.config.ts",
    "test:summary": "node scripts/test-summary.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "test:smoke": "node scripts/test-smoke.mjs",
    "test:milestone": "node scripts/test-milestone.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@openui5/sap.m": "1.154.0",
    "@openui5/sap.ui.core": "1.154.0",
    "@openui5/sap.ui.fl": "1.154.0",
    "@openui5/sap.ui.layout": "1.154.0",
    "@openui5/sap.ui.mdc": "1.154.0",
    "@openui5/themelib_sap_horizon": "1.154.0",
    "@playwright/test": "^1.64.1",
    "@sap-theming/theming-base-content": "11.36.5",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@ui5/cli": "4.0.71",
    "@ui5/webcomponents": "2.28.1",
    "@ui5/webcomponents-base": "2.28.1",
    "@ui5/webcomponents-fiori": "2.28.1",
    "@ui5/webcomponents-icons": "2.28.0",
    "@ui5/webcomponents-localization": "2.28.1",
    "@ui5/webcomponents-react": "2.28.2",
    "@ui5/webcomponents-react-base": "2.28.2",
    "@vitejs/plugin-react": "^6.1.2",
    "less-openui5": "0.12.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "shadcn": "4.23.0",
    "storybook": "10.6.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
